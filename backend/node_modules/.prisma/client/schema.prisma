generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  name     String?
  image    String? // Profile photo
  password String? // Optional for OAuth users
  role     String  @default("STUDENT")

  // Relations
  accounts  Account[]
  projects  UserProject[]
  syllabi   Syllabus[]
  resumes   Resume[]
  portfolio Portfolio?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// For OAuth tokens (GitHub, etc.)
model Account {
  id                String  @id @default(uuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "github", "google"
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?

  @@unique([provider, providerAccountId])
}

model Portfolio {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String?
  summary   String?
  jobTitle  String?
  funFact   String?
  skills    String? // Stored as comma-separated or JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Syllabus {
  id       String  @id @default(uuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id])
  content  String // Extracted text
  fileName String?
  fileType String?

  units     Unit[]
  createdAt DateTime @default(now())
}

model Unit {
  id         String   @id @default(uuid())
  syllabusId String
  syllabus   Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  title      String
  number     Int
  topics     Topic[]
}

model Topic {
  id       String    @id @default(uuid())
  unitId   String
  unit     Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name     String
  skills   String // Comma separated
  projects Project[]
}

model Project {
  id          String  @id @default(uuid())
  topicId     String?
  topic       Topic?  @relation(fields: [topicId], references: [id])
  title       String
  description String
  difficulty  String  @default("BEGINNER")
  techStack   String // Comma separated or JSON
  roadmap     String? // JSON string: [{task: "...", status: "TODO"}]

  userProjects UserProject[]
}

model UserProject {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  status    String  @default("TODO") // TODO, IN_PROGRESS, COMPLETED
  repoLink  String? // Link to GitHub repo
  repoStats String? // JSON: {commits: 12, lastUpdate: "..."}

  // AI Generated Outputs
  readme       String?
  linkedInPost String?

  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

model Resume {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String // e.g. "Frontend Resume"
  content   String // Generated Bullet points or full content
  createdAt DateTime @default(now())
}
